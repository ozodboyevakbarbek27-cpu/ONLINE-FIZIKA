<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport"
content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">

<title>UZB CHESS</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>

<style>
*{
 box-sizing:border-box;
 -webkit-tap-highlight-color:transparent;
}

body{
 margin:0;
 background:#080a0e;
 color:white;
 font-family:Arial,sans-serif;
}

.app{
 max-width:720px;
 margin:auto;
 min-height:100vh;
 padding-bottom:30px;
}

header{
 text-align:center;
 padding:20px 10px;
 background:#11151b;
 border-bottom:1px solid #292f38;
}

.logo{
 font-size:30px;
 font-weight:900;
}

.logo span{
 color:#e5b342;
}

.sub{
 color:#858d98;
 margin-top:5px;
}

.page{
 display:none;
 padding:14px;
}

.page.active{
 display:block;
}

.card{
 background:#151a20;
 border:1px solid #2b323c;
 border-radius:18px;
 padding:18px;
 margin-bottom:14px;
}

.menu{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px;
}

button{
 border:1px solid #303741;
 background:#171d24;
 color:white;
 border-radius:14px;
 padding:14px;
 font-size:16px;
 cursor:pointer;
}

button:active{
 transform:scale(.97);
}

.menu button{
 min-height:110px;
}

.menu button:first-child{
 border-color:#e5b342;
}

.icon{
 display:block;
 font-size:30px;
 margin-bottom:8px;
}

.primary{
 width:100%;
 margin-top:12px;
 background:#e5b342;
 color:#111;
 font-weight:bold;
}

.back{
 margin-bottom:12px;
}

.timegrid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:8px;
}

.time.selected,
.level.selected{
 border-color:#e5b342;
 color:#e5b342;
 background:#30240c;
}

.levelgrid{
 display:grid;
 grid-template-columns:1fr 1fr 1fr;
 gap:8px;
}

input{
 width:100%;
 margin-top:10px;
 padding:14px;
 border-radius:12px;
 border:1px solid #303741;
 background:#0d1116;
 color:white;
 font-size:16px;
}

.players{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:8px;
}

.player{
 background:#151a20;
 border:1px solid #2b323c;
 border-radius:15px;
 padding:11px;
}

.player.active{
 border-color:#e5b342;
 box-shadow:0 0 15px #e5b34222;
}

.pname{
 color:#aeb4bd;
}

.clock{
 color:#e5b342;
 font-size:27px;
 font-weight:bold;
 margin-top:4px;
}

.status{
 text-align:center;
 min-height:42px;
 padding:10px 0;
 color:#e5b342;
 font-weight:bold;
 font-size:18px;
}

#board{
 width:100%;
 aspect-ratio:1;
 display:grid;
 grid-template-columns:repeat(8,1fr);
 border:5px solid #252b32;
 border-radius:7px;
 overflow:hidden;
}

.square{
 position:relative;
 display:flex;
 align-items:center;
 justify-content:center;
 aspect-ratio:1;
}

.light{
 background:#ead5a4;
}

.dark{
 background:#765a3a;
}

.piece{
 font-size:clamp(38px,11vw,76px);
 line-height:1;
 user-select:none;
 z-index:2;
 filter:drop-shadow(0 3px 3px #0008);
}

.wp{
 color:white;
 text-shadow:0 2px 3px #555;
}

.bp{
 color:#111;
 text-shadow:0 2px 2px #fff5;
}

.selected{
 box-shadow:inset 0 0 0 5px #e5b342;
}

.possible:after{
 content:"";
 width:20%;
 height:20%;
 border-radius:50%;
 background:#e5b342;
 position:absolute;
}

.capture:after{
 content:"";
 position:absolute;
 inset:5px;
 border:4px solid #e5b342;
 border-radius:50%;
}

.incheck{
 box-shadow:
 inset 0 0 0 5px #e34d4d,
 inset 0 0 30px #e34d4d55;
}

.coord{
 position:absolute;
 font-size:10px;
 font-weight:bold;
 opacity:.65;
 z-index:3;
}

.rank{
 left:3px;
 top:2px;
}

.file{
 right:3px;
 bottom:2px;
}

.controls{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:7px;
 margin-top:10px;
}

.controls button{
 padding:12px 3px;
 font-size:12px;
}

.moves{
 margin-top:12px;
 padding:12px;
 background:#11161c;
 border:1px solid #292f38;
 border-radius:15px;
 max-height:180px;
 overflow:auto;
}

.move{
 padding:5px 0;
 border-bottom:1px solid #20262d;
 color:#b0b6bf;
}

.stat{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:8px;
}

.statbox{
 background:#11161c;
 border:1px solid #292f38;
 border-radius:14px;
 padding:14px;
 text-align:center;
}

.statnum{
 font-size:25px;
 font-weight:bold;
 color:#e5b342;
}

.small{
 color:#9299a3;
 line-height:1.5;
}

.center{
 text-align:center;
}

@media(max-width:400px){
 .piece{
  font-size:34px;
 }

 .controls button{
  font-size:10px;
 }
}
</style>
</head>

