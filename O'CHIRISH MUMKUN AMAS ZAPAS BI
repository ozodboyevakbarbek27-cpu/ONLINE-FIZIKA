<script>

/* =========================
   SOZLAMALAR
========================= */

let chess = new Chess();

let gameMode = "local";
let botColor = "b";
let myColor = "w";

let botLevel = 1;

let selectedTime = 600;

let boardFlipped = false;
let selectedSquare = null;

let gameActive = false;
let gameFinished = false;

let whiteTime = 0;
let blackTime = 0;

let timer = null;


/* =========================
   STATISTIKA
========================= */

let stats = JSON.parse(
 localStorage.getItem("uzbChessStats")
) || {
 rating:1200,
 games:0,
 wins:0,
 losses:0,
 draws:0
};


function saveStats(){

 localStorage.setItem(
  "uzbChessStats",
  JSON.stringify(stats)
 );

 updateProfile();

}


function updateProfile(){

document.getElementById("rating").textContent=stats.rating;
document.getElementById("games").textContent=stats.games;
document.getElementById("wins").textContent=stats.wins;
document.getElementById("losses").textContent=stats.losses;
document.getElementById("draws").textContent=stats.draws;

}

updateProfile();


/* =========================
   PAGE
========================= */

function showPage(id){

document.querySelectorAll(".page")
.forEach(x=>x.classList.remove("active"));

document.getElementById(id)
.classList.add("active");

window.scrollTo(0,0);

}


/* =========================
   SETUP
========================= */

function openBotSetup(){

showPage("botSetup");

}

function openLocalSetup(){

showPage("localSetup");

}

function openOnline(){

showPage("online");

}


function chooseColor(color,btn){

botColor =
color==="w" ? "b" : "w";

myColor=color;

document
.querySelectorAll("#botSetup .timegrid button")
.forEach(x=>{
 if(x.id==="whiteChoice" || x.id==="blackChoice")
 x.classList.remove("selected");
});

btn.classList.add("selected");

}


function chooseLevel(level,btn){

botLevel=level;

document
.querySelectorAll(".level")
.forEach(x=>x.classList.remove("selected"));

btn.classList.add("selected");

}


function chooseTime(sec,btn){

selectedTime=sec;

document
.querySelectorAll(".time")
.forEach(x=>x.classList.remove("selected"));

btn.classList.add("selected");

}


/* =========================
   START BOT
========================= */

function startBotGame(){

gameMode="bot";

startGame();

if(botColor==="w"){

setTimeout(botMove,400);

}

}


/* =========================
   START LOCAL
========================= */

function startLocalGame(){

gameMode="local";

startGame();

}


/* =========================
   START GAME
========================= */

function startGame(){

chess=new Chess();

boardFlipped=false;
selectedSquare=null;

gameActive=true;
gameFinished=false;

whiteTime=selectedTime;
blackTime=selectedTime;

document.getElementById("modeLabel")
.textContent =
gameMode==="bot"
?"● BOT"
:"● LOCAL";

document.getElementById("modeLabel")
.style.color="#63d28d";

showPage("game");

renderBoard();
updateUI();
updateMoves();

startTimer();

}


/* =========================
   BOARD
========================= */

const symbols={

w:{
p:"♙",
n:"♘",
b:"♗",
r:"♖",
q:"♕",
k:"♔"
},

b:{
p:"♟",
n:"♞",
b:"♝",
r:"♜",
q:"♛",
k:"♚"
}

};


function renderBoard(){

const el=document.getElementById("board");

el.innerHTML="";

const b=chess.board();

for(let dr=0;dr<8;dr++){

for(let dc=0;dc<8;dc++){

let r =
boardFlipped
?7-dr
:dr;

let c =
boardFlipped
?7-dc
:dc;

const sq=document.createElement("div");

sq.className =
((r+c)%2===0)
?"square light"
:"square dark";

const name =
String.fromCharCode(97+c)+(8-r);


if(selectedSquare===name)
sq.classList.add("selected");


if(selectedSquare){

const moves=chess.moves({
 square:selectedSquare,
 verbose:true
});

const m=moves.find(x=>x.to===name);

if(m){

sq.classList.add(
 m.captured
 ?"capture"
 :"possible"
);

}

}


const piece=b[r][c];

if(piece){

const p=document.createElement("span");

p.className=
"piece "+
(piece.color==="w"?"wp":"bp");

p.textContent=
symbols[piece.color][piece.type];

sq.appendChild(p);

}


if(dr===0){

const rank=document.createElement("span");

rank.className="coord rank";

rank.textContent=8-r;

sq.appendChild(rank);

}


if(dr===7){

const file=document.createElement("span");

file.className="coord file";

file.textContent=
String.fromCharCode(97+c);

sq.appendChild(file);

}


if(
piece &&
piece.type==="k" &&
chess.in_check() &&
piece.color===chess.turn()
){

sq.classList.add("incheck");

}


sq.onclick=()=>clickSquare(name);

el.appendChild(sq);

}

}

}


/* =========================
   CLICK
========================= */

function clickSquare(name){

if(!gameActive)
return;


/* BOT NAVBATI */

if(
gameMode==="bot" &&
chess.turn()!==myColor
)
return;


const piece=chess.get(name);


if(selectedSquare){

const moves=chess.moves({
 square:selectedSquare,
 verbose:true
});

const move=moves.find(
x=>x.to===name
);


if(move){

makeMove(
selectedSquare,
name
);

return;

}


if(
piece &&
piece.color===chess.turn()
){

selectedSquare=name;

renderBoard();

return;

}


selectedSquare=null;

renderBoard();

return;

}


if(
piece &&
piece.color===chess.turn()
){

selectedSquare=name;

renderBoard();

}

}


/* =========================
   MOVE
========================= */

function makeMove(from,to){

const move=chess.move({

from:from,
to:to,
promotion:"q"

});

if(!move)
return;

selectedSquare=null;

renderBoard();
updateUI();
updateMoves();

if(checkGameEnd())
return;


/* BOT */

if(gameMode==="bot"){

setTimeout(botMove,250);

}

}


/* =========================
   BOT AI
========================= */

function botMove(){

if(!gameActive)
return;

if(gameMode!=="bot")
return;

if(chess.turn()!==botColor)
return;


const moves=chess.moves({
verbose:true
});

if(!moves.length)
return;


let chosen;


/* OSON */

if(botLevel===1){

chosen=
moves[
Math.floor(
Math.random()*moves.length
)
];

}


/* O‘RTA */

else if(botLevel===2){

let captures=
moves.filter(x=>x.captured);

if(captures.length){

chosen=
captures[
Math.floor(
Math.random()*captures.length
)
];

}else{

chosen=
moves[
Math.floor(
Math.random()*moves.length
)
];

}

}


/* QIYIN */

else{

chosen=findBestMove();

}


if(!chosen)
chosen=moves[0];


chess.move({

from:chosen.from,
to:chosen.to,
promotion:"q"

});

renderBoard();
updateUI();
updateMoves();

checkGameEnd();

}


/* =========================
   SIMPLE AI
========================= */

const values={
p:100,
n:320,
b:330,
r:500,
q:900,
k:20000
};


function findBestMove(){

const moves=chess.moves({
verbose:true
});

let best=-Infinity;
let bestMoves=[];


for(const m of moves){

chess.move({
from:m.from,
to:m.to,
promotion:"q"
});

let score=
evaluatePosition();

chess.undo();


if(
score>best
){

best=score;
bestMoves=[m];

}else if(score===best){

bestMoves.push(m);

}

}


return bestMoves[
Math.floor(
Math.random()*bestMoves.length
)
];

}


function evaluatePosition(){

let score=0;

const board=chess.board();

for(let r=0;r<8;r++){

for(let c=0;c<8;c++){

const p=board[r][c];

if(!p)
continue;

const value=values[p.type];

if(p.color===botColor)
score+=value;
else
score-=value;

}

}

return score;

}


/* =========================
   UNDO
========================= */

function undoGame(){

if(gameMode==="bot"){

if(chess.history().length>=2){

chess.undo();
chess.undo();

renderBoard();
updateUI();
updateMoves();

}

return;

}


if(chess.history().length){

chess.undo();

renderBoard();
updateUI();
updateMoves();

}

}


/* =========================
   NEW GAME
========================= */

function newGame(){

if(gameMode==="bot")
startBotGame();
else
startLocalGame();

}


/* =========================
   FLIP
========================= */

function flipBoard(){

boardFlipped=!boardFlipped;

renderBoard();

}


/* =========================
   TIMER
========================= */

function startTimer(){

clearInterval(timer);

if(selectedTime===0){

updateClocks();

return;

}


timer=setInterval(()=>{

if(!gameActive)
return;


if(chess.turn()==="w")
whiteTime--;
else
blackTime--;


if(whiteTime<=0){

whiteTime=0;

finishGame(
"timeout",
"white"
);

}


if(blackTime<=0){

blackTime=0;

finishGame(
"timeout",
"black"
);

}


updateClocks();

},1000);

}


function updateClocks(){

document.getElementById("whiteClock")
.textContent =
selectedTime===0
?"∞"
:formatTime(whiteTime);

document.getElementById("blackClock")
.textContent =
selectedTime===0
?"∞"
:formatTime(blackTime);

}


function formatTime(s){

let m=Math.floor(
Math.max(0,s)/60
);

let x=
Math.max(0,s)%60;

return m+":"+
(x<10?"0":"")+x;

}


/* =========================
   UI
========================= */

function updateUI(){

document
.getElementById("whitePlayer")
.classList.toggle(
"active",
chess.turn()==="w"
);

document
.getElementById("blackPlayer")
.classList.toggle(
"active",
chess.turn()==="b"
);


let status;

if(chess.in_check()){

status =
chess.turn()==="w"
?"⚠️ Oqga SHOH!"
:"⚠️ Qoraga SHOH!";

}else{

status =
chess.turn()==="w"
?"⚪ Oq yuradi"
:"⚫ Qora yuradi";

}


if(
gameMode==="bot"
){

status +=
chess.turn()===myColor
?" • Sizning navbatingiz"
:" • Bot o‘ylamoqda...";

}


document.getElementById("status")
.textContent=status;

updateClocks();

}


/* =========================
   MOVES
========================= */

function updateMoves(){

const el=
document.getElementById("moveList");

el.innerHTML="";

const h=chess.history();

for(let i=0;i<h.length;i+=2){

const d=document.createElement("div");

d.className="move";

d.innerHTML=
"<b>"+(Math.floor(i/2)+1)+".</b> "+
(h[i]||"")+" "+
(h[i+1]||"");

el.appendChild(d);

}

el.scrollTop=el.scrollHeight;

}


/* =========================
   GAME END
========================= */

function checkGameEnd(){

if(!chess.game_over())
return false;

if(gameFinished)
return true;

gameFinished=true;
gameActive=false;

clearInterval(timer);


if(chess.in_check()){

const winner=
chess.turn()==="w"
?"b"
:"w";

finishResult(winner);

}else{

finishResult("draw");

}

return true;

}


/* =========================
   FINISH
========================= */

function finishGame(type,color){

if(gameFinished)
return;

gameFinished=true;
gameActive=false;

clearInterval(timer);

if(type==="timeout"){

const winner=
color==="white"
?"b"
:"w";

finishResult(winner);

}

}


function finishResult(result){

/*
 Faqat haqiqiy tugagan o‘yin
 statistika hisoblanadi.
*/

stats.games++;


if(result==="draw"){

stats.draws++;

document.getElementById("status")
.textContent="🤝 DURANG!";

}else if(result===myColor){

stats.wins++;

stats.rating+=10;

document.getElementById("status")
.textContent=
"🏆 SIZ G‘ALABA QILDINGIZ!";

}else{

stats.losses++;

stats.rating=
Math.max(0,stats.rating-10);

document.getElementById("status")
.textContent=
"❌ SIZ MAG‘LUB BO‘LDINGIZ!";

}


saveStats();

}


/* =========================
   LEAVE
========================= */

function leaveGame(){

gameActive=false;

clearInterval(timer);

showPage("home");

}

</script>

